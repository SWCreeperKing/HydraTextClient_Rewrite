; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hydra Text Client"
run/main_scene="uid://bx4f8xlchuvfs"
config/features=PackedStringArray("4.8", "C#", "GL Compatibility")
run/max_fps=30
config/icon="uid://dlt2apjya0nli"
config/windows_native_icon="res://Assets/Icon/HydraTextClientLogo.ico"

[display]

window/size/transparent=true
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="Hydra Text Client"

[editor]

movie_writer/disable_vsync=true
movie_writer/fps=20

